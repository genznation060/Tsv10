<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboardRootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/kb_bg"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Utility Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/kb_bar_bg"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvKeyboardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/kb_header_title"
            android:textColor="@color/kb_text_dim"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/btnOpenApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙ APP"
            android:textColor="@color/kb_text_dim"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSwitchIme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kb_btn_switch_ime"
            android:textColor="@color/kb_text_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnHideKeyboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ✕ "
            android:textColor="@color/kb_text_dim"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Horizontal Category Tabs -->
    <HorizontalScrollView
        android:id="@+id/hsvCategories"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:scrollbars="none"
        android:fillViewport="false"
        android:background="@color/kb_bg">

        <LinearLayout
            android:id="@+id/layoutCategoryTabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </HorizontalScrollView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/kb_divider" />

    <!-- Search & Insert All Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/kb_bar_bg">

        <!-- Search input box -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_search_input"
                android:hint="@string/kb_hint_search"
                android:textColorHint="@color/kb_text_dim"
                android:textColor="@color/kb_text_white"
                android:textSize="12sp"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="28dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/btnClearSearch"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/kb_text_dim"
                android:textSize="12sp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <!-- INSERT ALL Button -->
        <TextView
            android:id="@+id/btnInsertAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_keyboard_action"
            android:text="@string/kb_btn_insert_all"
            android:textColor="@color/kb_text_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Values List & Empty State Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@color/kb_bg">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvValues"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvEmptyStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kb_no_data"
                android:textColor="@color/kb_text_dim"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/btnEmptyOpenApp"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_keyboard_action"
                android:text="@string/kb_open_app"
                android:textColor="@color/kb_text_white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </FrameLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/kb_divider" />

    <!-- Bottom Keyboard Navigation & Key Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@color/kb_bar_bg">

        <!-- TAB Key -->
        <TextView
            android:id="@+id/btnTabKey"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_keyboard_key"
            android:text="@string/kb_btn_tab"
            android:textColor="@color/kb_text_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- SPACE Key -->
        <TextView
            android:id="@+id/btnSpaceKey"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_keyboard_key"
            android:text="@string/kb_btn_space"
            android:textColor="@color/kb_text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- BACKSPACE Key -->
        <TextView
            android:id="@+id/btnBackspaceKey"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_keyboard_key"
            android:text="@string/kb_btn_backspace"
            android:textColor="@color/kb_text_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- ENTER Key -->
        <TextView
            android:id="@+id/btnEnterKey"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_keyboard_action"
            android:text="@string/kb_btn_enter"
            android:textColor="@color/kb_text_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
