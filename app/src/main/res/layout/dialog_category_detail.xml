<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface_light">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvDialogCategoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearAllValues"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="CLEAR ALL"
            android:textSize="11sp"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="@color/danger" />
    </LinearLayout>

    <!-- Add Value Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etNewValue"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_input"
            android:hint="Add new value…"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnAddValue"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="+ ADD"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Filter input -->
    <EditText
        android:id="@+id/etFilterValues"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_search_input"
        android:hint="Filter values in this category…"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <!-- Values List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategoryValues"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/tvEmptyValues"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="@string/empty_values_hint"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Close Button -->
    <Button
        android:id="@+id/btnCloseDialog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="DONE"
        android:textStyle="bold"
        android:backgroundTint="@color/primary"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp" />
</LinearLayout>
