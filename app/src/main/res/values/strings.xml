    <!-- Privacy & Guidance -->
    <string name="privacy_title">Security &amp; Privacy Notice</string>
    <string name="privacy_body">100% Offline &amp; Safe: This app has NO Internet permission. Your TSV data is stored strictly on your local device. The keyboard never logs keystrokes, never intercepts what you type in other apps, and only inserts text when you tap a category value.</string>

    <!-- How to use -->
    <string name="setup_title">How to Enable System Keyboard</string>
    <string name="setup_step1">1. Tap "Open Keyboard Settings" below and enable "TSV Category Keyboard".</string>
    <string name="setup_step2">2. In any app (Chrome, Notes, WhatsApp), tap a text field.</string>
    <string name="setup_step3">3. Switch keyboard to "TSV Category Keyboard" using the keyboard picker icon.</string>
